{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb", "runtime": "python3.12" }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/refresh-nav",
      "schedule": "30 17 * * *"
    },
    {
      "path": "/api/v1/cron/rebalance-check",
      "schedule": "0 18 * * *"
    }
  ]
}